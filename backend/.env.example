# Tripora backend environment template.
# Copy to backend/.env for local development. NEVER commit a filled-in copy.
# In production set these in the Render dashboard (Environment), not in files.
# Full reference: SECURITY.md -> "Security-related environment variables".

# --- Database (PostgreSQL) ---------------------------------------------
# Runtime credentials = the least-privilege role `tripora_runtime`
# (backend/db/roles.sql). The owner/migrator role is used ONLY by the
# pre-deploy `flask db upgrade` step (DB_MIGRATION_USER/PASSWORD below).
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripora
# Remote hosts default to "require". Use "verify-full" in production when the
# provider CA is available. Leave empty for a local database.
DB_SSLMODE=
# Owner/migrator credentials. Set ONLY in the environment of the migration
# step (Render pre-deploy command), never for the web process.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# --- Auth ----------------------------------------------------------------
# >= 32 random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Administrators (TRP-17) ---------------------------------------------
# Fernet key that encrypts admin TOTP secrets at rest. Required for admin
# sign-in (without it admin login answers 503). Generate once and keep it:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Losing/rotating it invalidates every enrolled authenticator (re-enroll with
# `flask admin reset-mfa`).
MFA_ENCRYPTION_KEY=
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8

# LEGACY shared secret for /api/admin/*. Transitional only: set
# ADMIN_LEGACY_TOKEN_ENABLED=false and clear ADMIN_API_TOKEN once an MFA
# administrator has signed in. >= 32 random characters while still used.
ADMIN_API_TOKEN=
ADMIN_LEGACY_TOKEN_ENABLED=true

# Google / Apple sign-in audiences (only the ones you use).
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=
APPLE_CLIENT_ID=

# --- Network / proxy -----------------------------------------------------
# Comma-separated browser origins allowed by CORS (your Vercel URL).
CORS_ORIGINS=http://localhost:3000
# Reverse-proxy hops that append X-Forwarded-For. Defaults to 1 on Render
# (RENDER=true) and 0 elsewhere. Never set higher than the real hop count.
TRUSTED_PROXY_HOPS=

# --- Third-party providers (server-side only; never in the Flutter app) --
GEMINI_API_KEY=
TRAVELPAYOUTS_API_KEY=
DUFFEL_API_TOKEN=

# --- Email (password reset) ----------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Tripora
# Resend is used only when SMTP (MAIL_HOST + MAIL_USER + MAIL_PASSWORD) is not
# configured. RESEND_FROM_EMAIL must be an address on a domain verified in
# Resend; the default onboarding@resend.dev only reaches the Resend account
# owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Tripora
# Unset (= production) in every deployed environment. Only "development" /
# "test" enable the provider-less e-mail simulation, which reports success
# without sending anything.
# TRIPORA_ENV=development

# --- Bot protection: Cloudflare Turnstile (register + forgot-password) -----
# Unset TURNSTILE_ENABLED = ON, except when TRIPORA_ENV is development/test.
# Enabled without a secret = those two endpoints answer 503 (fail closed).
# TURNSTILE_ENABLED=true
# Server-only. Never put it in the Flutter app, vercel.json or any client.
TURNSTILE_SECRET_KEY=
# Public; served to the app by GET /api/turnstile/config.
TURNSTILE_SITE_KEY=
# Hosts where the widget may be solved: the web app's host AND the API host
# (it serves the Android challenge page), e.g.
# tripora-iota.vercel.app,tripora-4mt3.onrender.com
TURNSTILE_ALLOWED_HOSTNAMES=
# Siteverify timeout in seconds (1-10).
TURNSTILE_TIMEOUT_SECONDS=5
# Local development: TRIPORA_ENV=development turns protection off. Cloudflare's
# dummy keys (site key 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA) render the real widget, but Siteverify
# returns no action for them (and hostname example.com), so this backend
# rejects them with action_mismatch. That is intended. For end-to-end tests,
# use a separate development widget whose hostnames include localhost.

# --- Operations ----------------------------------------------------------
LOG_LEVEL=INFO
REQUEST_LOGGING_ENABLED=true
RATE_LIMIT_ENABLED=true
# Shared rate-limit store (Render Key Value internal URL, or rediss:// for
# TLS). Empty = per-process memory (local development).
REDIS_URL=
# fallback (default): count in memory if Redis is down. closed: reject
# auth/admin/AI requests with 503 while Redis is down.
RATE_LIMIT_FAILURE_MODE=fallback
REDIS_RETRY_SECONDS=30
# Platform-wide Gemini ceiling across all users (per window, seconds).
RATE_LIMIT_AI_GLOBAL_LIMIT=300
RATE_LIMIT_AI_GLOBAL_WINDOW=3600
# Dev server only (python app.py). Never enable on a reachable host.
FLASK_DEBUG=0
