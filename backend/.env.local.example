# Local-only backend configuration (used with TRIPORA_LOCAL_ONLY=1).
#
#   cp backend/.env.local.example backend/.env.local   # gitignored
#   bash backend/scripts/run_local.sh                  # see SECURITY_TESTING_GUIDE.md
#
# In local-only mode backend/.env is NEVER loaded (it may point at production),
# DB_HOST must be a loopback address (anything else is refused before any
# connection), and e-mail is never sent. Never put production values here.

# --- Local PostgreSQL test container (see SECURITY_TESTING_GUIDE.md) --------
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=tripora_local
DB_USER=tripora_owner
DB_PASSWORD=local-test-only
DB_SSLMODE=disable

# --- App ---------------------------------------------------------------------
TRIPORA_ENV=development
# Any random local value of >= 32 characters, e.g.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
REDIS_URL=
# GROQ_API_KEY is required at start-up. A placeholder keeps AI features off
# locally; never copy the production key here. For live local AI tests,
# use a separate development key from the Groq console.
GROQ_API_KEY=local-placeholder-ai-disabled

# --- Cloudflare Turnstile: DEVELOPMENT widget only ----------------------------
# A separate Managed widget whose only hostname is `localhost`. Never the
# production widget's keys. Cloudflare's dummy keys do not return `action`,
# so the backend rejects them (action_mismatch) by design.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost
TURNSTILE_TIMEOUT_SECONDS=5

# --- E-mail ------------------------------------------------------------------
# Leave empty. Local-only mode simulates delivery and never sends.
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
RESEND_API_KEY=
